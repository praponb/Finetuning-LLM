# environments
.venv/
mlx-env/
# API keys: .env holds KIMI_API_KEY (and optionally KIMI_BASE_URL, KIMI_MODEL) for the Kimi K3 repair
.env
__pycache__/
*.pyc

# model binaries and large fused artifacts (can be rebuilt with `make export`)
*.gguf
sql2pyspark-hf/
sql2pyspark-model/
sql2pyspark-mlx/sql2pyspark-model/
archive/

# vendored upstream checkout
llama.cpp/

# local agent/editor tooling (symlinks into the venv)
.agents/
.claude/


# intermediate LoRA checkpoints (every 100-200 iterations); only each run's final adapters.safetensors is tracked
[0-9][0-9][0-9][0-9][0-9][0-9][0-9]_adapters.safetensors
# macOS
.DS_Store
# train_resumable.py restart leftovers (segment adapters + resume configs), deleted after a run
sql2pyspark-mlx/adapters_*_seg[0-9]*/
sql2pyspark-mlx/.resume_seg[0-9]*.yaml
# harness_v20 Kimi pilot outputs (pairs + logs stay local until a training round uses them)
sql2pyspark-mlx/harness_v20/pilot/
sql2pyspark-mlx/harness_v20/pilot*.log
# Spark scratch from the suites
sql2pyspark_sql_suite/spark-warehouse/
