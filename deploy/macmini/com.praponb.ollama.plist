<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ollama server for sql2pyspark.praponb.com on the Mac mini: runs at boot as praponb (models in ~/.ollama),
     without a GUI login. Replaces the Ollama app's own server: remove Ollama from the Login Items. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.praponb.ollama</string>
  <key>UserName</key><string>praponb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/praponb</string>
    <key>OLLAMA_HOST</key><string>127.0.0.1:11434</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/praponb/Library/Logs/sql2pyspark/ollama.log</string>
  <key>StandardErrorPath</key><string>/Users/praponb/Library/Logs/sql2pyspark/ollama.log</string>
</dict>
</plist>
