{
    "adapter_path": "./adapters",
    "batch_size": 2,
    "clear_cache_threshold": 0,
    "config": "lora_config.yaml",
    "data": "./data",
    "fine_tune_type": "lora",
    "grad_accumulation_steps": 2,
    "grad_checkpoint": true,
    "iters": 2400,
    "learning_rate": 5e-05,
    "lora_parameters": {
        "rank": 16,
        "dropout": 0.05,
        "scale": 20.0
    },
    "lr_schedule": {
        "name": "cosine_decay",
        "warmup": 50,
        "warmup_init": 1e-06,
        "arguments": [
            5e-05,
            1150,
            5e-06
        ]
    },
    "mask_prompt": true,
    "max_seq_length": 3200,
    "model": "mlx-community/Qwen2.5-Coder-3B-Instruct-4bit",
    "num_layers": 8,
    "optimizer": "adamw",
    "optimizer_config": {
        "adam": {},
        "adamw": {},
        "muon": {},
        "sgd": {},
        "adafactor": {}
    },
    "project_name": null,
    "report_to": null,
    "resume_adapter_file": "./runs/v4/adapters/adapters.safetensors",
    "save_every": 100,
    "seed": 0,
    "steps_per_eval": 600,
    "steps_per_report": 50,
    "test": false,
    "test_batches": 200,
    "train": true,
    "val_batches": 50
}