{
    "adapter_path": "./adapters",
    "batch_size": 4,
    "clear_cache_threshold": 0,
    "config": "lora_config.yaml",
    "data": "./data",
    "fine_tune_type": "lora",
    "grad_accumulation_steps": 1,
    "grad_checkpoint": false,
    "iters": 1200,
    "learning_rate": 0.0001,
    "lora_parameters": {
        "rank": 16,
        "dropout": 0.05,
        "scale": 20.0
    },
    "lr_schedule": {
        "name": "cosine_decay",
        "warmup": 100,
        "warmup_init": 1e-06,
        "arguments": [
            0.0001,
            1100,
            1e-05
        ]
    },
    "mask_prompt": true,
    "max_seq_length": 1024,
    "model": "mlx-community/Qwen2.5-Coder-3B-Instruct-4bit",
    "num_layers": 8,
    "optimizer": "adamw",
    "optimizer_config": {
        "adam": {},
        "adamw": {},
        "muon": {},
        "sgd": {},
        "adafactor": {}
    },
    "project_name": null,
    "report_to": null,
    "resume_adapter_file": null,
    "save_every": 300,
    "seed": 0,
    "steps_per_eval": 300,
    "steps_per_report": 25,
    "test": false,
    "test_batches": 200,
    "train": true,
    "val_batches": 25
}